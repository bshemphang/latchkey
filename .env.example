# Firebase web config — copy to .env and fill in from the Firebase console.
# The web config is public by design and contains no secrets.
# Never put API keys, App Check debug tokens, or any secret in this repo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# reCAPTCHA v3 site key for App Check in production.
# Leave empty in development (the debug provider is used instead).
# Register the key in the Firebase console (App Check > reCAPTCHA v3)
# and paste it here only in the local .env.local, never in the repo.
VITE_RECAPTCHA_V3_SITE_KEY=

# App Check debug token for local development ONLY (dev provider).
# The SDK prints a fresh token to the console when this is empty; register
# it once in the Firebase console (App Check > Manage debug tokens).
# This value is a secret: it lives only in .env.local, never in the repo,
# and never in the production build (see src/appcheck.ts resolveDebugToken).
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
