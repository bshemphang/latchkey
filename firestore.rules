rules_version = '2';

// Latchkey tracker rules. Each application document belongs to one user:
// only that signed-in user may read or write it. The app writes documents
// with a `uid` field and subscribes with a uid query (see src/store/tracker.ts).
service cloud.firestore {
  match /databases/{database}/documents {
    match /applications/{docId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }
  }
}
